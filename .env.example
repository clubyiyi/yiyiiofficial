# Copia este archivo como .env.local (no se sube al repositorio) y rellena los valores.

# Proveedor del catálogo: "mock" (catálogo local de src/data) o "shopify"
VITE_COMMERCE_PROVIDER=shopify

# --- Shopify Storefront API ---
VITE_SHOPIFY_STORE_DOMAIN=hky1rh-b8.myshopify.com
# Token PÚBLICO de Storefront API (canal Headless o app personalizada → «Token de acceso público»).
# Es seguro en el navegador. NUNCA pongas aquí el token de Admin API (shpat_…).
VITE_SHOPIFY_STOREFRONT_TOKEN=
VITE_SHOPIFY_API_VERSION=2025-10
# País del mercado (moneda PEN)
VITE_SHOPIFY_COUNTRY=PE
# true solo si activas el alcance unauthenticated_read_product_inventory (avisos «¡Solo quedan N!»)
VITE_SHOPIFY_INVENTORY=false
